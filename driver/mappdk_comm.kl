ROUTINE OPEN_COMM(comm_file: FILE;
                  server_num: INTEGER;
                  port_number: INTEGER)
----------------------------------------------------
-- Opens the socket connection.
----------------------------------------------------
-- Parameters:
--          comm_file:      communication file.
--          server_num:     server tag number.
--          port_number:    port number.
----------------------------------------------------
-- Returns: nothing.
----------------------------------------------------
VAR
    entry:              INTEGER
    status:             INTEGER
    resp:               STRING[254]
    server_str:         STRING[2]
    server_tag:         STRING[4]
BEGIN
    -- Build the server tag string
    CNV_INT_STR(server_num, 1, 0, server_str)
    server_str = SUB_STR(server_str, 2, 1) -- upstream comment: "this is weird" (only takes the 2nd char, so tag is limited to S1-S9)
    server_tag = 'S' + server_str + ':'

    -- Set the server port number
    -- (undocumented upstream)
    SET_VAR(entry,
            '*SYSTEM*',
            '$HOSTS_CFG[' + server_str + '].$SERVER_PORT',
            port_number, status)

    -- Bring up the server
    MSG_DISCO(server_tag, status)
    CLOSE FILE comm_file

    -- Start the socket connection
    SET_FILE_ATR(comm_file, ATR_IA)
    MSG_CONNECT(server_tag, status)

    OPEN FILE comm_file ('rw', server_tag)

    -- Send a greeting once the connection is up
    resp = '0:success'
    WRITE comm_file (resp)
END OPEN_COMM


ROUTINE CLOSE_COMM(comm_file: FILE; server_num: INTEGER)
----------------------------------------------------
-- Closes the socket connection.
----------------------------------------------------
-- Parameters:
--          comm_file:      communication file.
--          server_num:     server tag number.
----------------------------------------------------
-- Returns: nothing.
----------------------------------------------------
VAR
    status:             INTEGER
    server_str:         STRING[2]
    server_tag:         STRING[4]
BEGIN
    -- Build the server tag string
    CNV_INT_STR(server_num, 1, 0, server_str)
    server_str = SUB_STR(server_str, 2, 1) -- upstream comment: "this is weird" (only takes the 2nd char, so tag is limited to S1-S9)
    server_tag = 'S' + server_str + ':'

    -- Tear down the connection
    CLOSE FILE comm_file
    MSG_DISCO(server_tag, status)
END CLOSE_COMM
