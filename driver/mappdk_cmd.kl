ROUTINE GET_CURPOS(cmd: STRING): STRING
----------------------------------------------------
-- Reads the TCP's current Cartesian position.
----------------------------------------------------
-- Parameters:
--      cmd [in]:           command string.
----------------------------------------------------
-- Returns: response string.
----------------------------------------------------
VAR
    resp:           STRING[254]
    out:            STRING[254]
    cpos:           XYZWPR
BEGIN
    cpos = CURPOS(0, 0)

    CNV_REAL_STR(cpos.x, 8, 3, out)
    resp = '0:x=' + out

    CNV_REAL_STR(cpos.y, 8, 3, out)
    resp = resp + ',y=' + out

    CNV_REAL_STR(cpos.z, 8, 3, out)
    resp = resp + ',z=' + out

    CNV_REAL_STR(cpos.w, 8, 3, out)
    resp = resp + ',w=' + out

    CNV_REAL_STR(cpos.p, 8, 3, out)
    resp = resp + ',p=' + out

    CNV_REAL_STR(cpos.r, 8, 3, out)
    resp = resp + ',r=' + out

    RETURN(resp)
END GET_CURPOS


ROUTINE GET_CURJPOS(cmd: STRING): STRING
----------------------------------------------------
-- Reads the TCP's current joint position.
----------------------------------------------------
-- Parameters:
--      cmd [in]:           command string.
----------------------------------------------------
-- Returns: response string.
----------------------------------------------------
VAR
    resp:           STRING[254]
    out:            STRING[254]
    jpos:           JOINTPOS
    joint_vals:     ARRAY[9] OF REAL
    status:         INTEGER
    i:              INTEGER

BEGIN
    jpos = CURJPOS(0, 0)

    CNV_JPOS_REL(jpos, joint_vals, status)
    IF status <> 0 THEN
        resp = '1:cannot-convert-joint-vals'
        RETURN(resp)
    ENDIF

    resp = '0:'
    FOR i=1 TO ARRAY_LEN(joint_vals) DO
        IF UNINIT(joint_vals[i]) THEN
            out='none'
        ELSE
            CNV_REAL_STR(joint_vals[i], 8, 3, out)
        ENDIF
        IF i=1 THEN
            resp = resp + 'j=' + out
        ELSE
            resp = resp + ',j=' + out
        ENDIF

    ENDFOR

    RETURN(resp)
END GET_CURJPOS


ROUTINE GET_INS_PWR(cmd: STRING): STRING
----------------------------------------------------
-- Reads instantaneous power consumption.
----------------------------------------------------
-- Parameters:
--      cmd [in]:           command string.
----------------------------------------------------
-- Returns: response string.
----------------------------------------------------
VAR
    resp:           STRING[254]
    status:         INTEGER
    ins_pwr:        REAL

BEGIN
    GET_VAR(entry, '*SYSTEM*', '$PRO_CFG.$INS_PWR', ins_pwr, status)

    IF status <> 0 THEN
        resp = '1:cannot-get-ins_pwr'
        RETURN(resp)
    ENDIF

    CNV_REAL_STR(ins_pwr, 6, 6, resp)
    resp = '0:' + resp

    RETURN(resp)
END GET_INS_PWR


ROUTINE MOVEJ(cmd: STRING): STRING
----------------------------------------------------
-- Joint-space motion.
-- Command string format:
-- movej:vel_val:cnt_val:nj:J1:J2:J3:J4:J5:J6
-- where:
-- vel_val: 3 digits, e.g. 002, 020, 100
-- cnt_val: 3 digits, e.g. 003, 030, 100
-- nj: axis count, a single character, e.g. 6, 7
-- J1: fixed-point number, e.g. +1234567890.0987654321
-- J2 ... Jn same format as J1
----------------------------------------------------
-- Parameters:
--      cmd [in]:           command string.
----------------------------------------------------
-- Returns: response string.
----------------------------------------------------
VAR
    status:             INTEGER
    vel_val:            INTEGER
    acc_val:            INTEGER
    cnt_val:            INTEGER
    mtn_type:           INTEGER
    nj:                 INTEGER
    i:                  INTEGER
    joint_vals:         ARRAY[9] OF REAL
    jval:               REAL
    jpos:               JOINTPOS6
    out_pos:            POSITION
    ext_ang:            ARRAY[6] OF REAL
    wjnt_cfg:           CONFIG
    start:              INTEGER
    prog_index:         INTEGER
    resp:               STRING[254]

CONST
    n_chars = 14
BEGIN
    start = 7

    -- Extract the velocity value and write it to R[81]
    CNV_STR_INT(SUB_STR(cmd, start, 4), vel_val)
    SET_INT_REG(81, vel_val, status)
    IF status <> 0 THEN
        resp = '1:R[81]-was-not-set'
        WRITE('Error: ', status, CR)
        RETURN(resp)
    ENDIF
    start = start + 4 + 1

    -- Extract the acceleration value and write it to R[82]
    CNV_STR_INT(SUB_STR(cmd, start, 4), acc_val)
    SET_INT_REG(82, acc_val, status)
    IF status <> 0 THEN
        resp = '1:R[82]-was-not-set'
        WRITE('Error: ', status, CR)
        RETURN(resp)
    ENDIF
    start = start + 4 + 1

    -- Extract the CNT value and write it to R[83]
    CNV_STR_INT(SUB_STR(cmd, start, 3), cnt_val)
    SET_INT_REG(83, cnt_val, status)
    IF status <> 0 THEN
        resp = '1:R[83]-was-not-set'
        WRITE('Error: ', status, CR)
        RETURN(resp)
    ENDIF
    start = start + 3 + 1

    -- Extract the motion type
    CNV_STR_INT(SUB_STR(cmd, start, 1), mtn_type)
    start = start + 1 + 1

    -- Extract the axis count
    CNV_STR_INT(SUB_STR(cmd, start, 1), nj)
    start = start + 1 + 1

    -- Read each joint angle from the command string
    -- and convert to JOINTPOS6
    FOR i=1 TO nj DO
        CNV_STR_REAL(SUB_STR(cmd, start, n_chars), jval)
        joint_vals[i] = jval
        start = start + n_chars + 1
        -- WRITE('Value ', i, ': ', jval, CR)
    ENDFOR
    CNV_REL_JPOS(joint_vals, jpos, status)
    IF status <> 0 THEN
        resp = '1:error-in-joint-values'
        WRITE('Error: ', status, CR)
        RETURN(resp)
    ENDIF

    -- Convert the joint angles to a Cartesian position via forward
    -- kinematics, which also checks reachability
    out_pos = CURPOS(0, 0)
    JOINT2POS(jpos, $UFRAME, $UTOOL, 0,
              out_pos, wjnt_cfg, ext_ang, status)
    IF status <> 0 THEN
        resp = '1:position-is-not-reachable'
        RETURN(resp)
    ENDIF

    -- Write the joint position to PR[81]
    SET_JPOS_REG(81, jpos, status)
    IF status <> 0 THEN
        resp = '1:PR[81]-was-not-set'
        RETURN(resp)
    ENDIF

    IF mtn_type = 1 THEN
        -- Linear interpolation
        CALL_PROGLIN('MAPPDK_MOVEL', 1, prog_index, FALSE)
    ELSE
        -- Joint interpolation
        CALL_PROGLIN('MAPPDK_MOVE', 1, prog_index, FALSE)
    ENDIF

    resp = '0:success'
    RETURN(resp)

END MOVEJ


ROUTINE MOVEP(cmd: STRING): STRING
----------------------------------------------------
-- Cartesian motion.
-- Command string format:
-- movep:vel_val:cnt_val:nj:X:Y:Z:W:P:R
-- where:
-- vel_val: 3 digits, e.g. 002, 020, 100
-- cnt_val: 3 digits, e.g. 003, 030, 100
-- nj: axis count, a single character, nj = 6
-- X: fixed-point number, e.g. +1234567890.0987654321
-- Y, Z, W, P, R same format as X
----------------------------------------------------
-- Parameters:
--      cmd [in]:           command string.
----------------------------------------------------
-- Returns: response string.
----------------------------------------------------
VAR
    status:             INTEGER
    vel_val:            INTEGER
    acc_val:            INTEGER
    cnt_val:            INTEGER
    mtn_type:           INTEGER
    nj:                 INTEGER
    i:                  INTEGER
    pose:               XYZWPR
    pval:               REAL
    start:              INTEGER
    prog_index:         INTEGER
    resp:               STRING[254]

CONST
    n_chars = 14
BEGIN
    start = 7

    -- Extract the velocity value and write it to R[81]
    CNV_STR_INT(SUB_STR(cmd, start, 4), vel_val)
    SET_INT_REG(81, vel_val, status)
    IF status <> 0 THEN
        resp = '1:R[81]-was-not-set'
        WRITE('Error: ', status, CR)
        RETURN(resp)
    ENDIF
    start = start + 4 + 1

    -- Extract the acceleration value and write it to R[82]
    CNV_STR_INT(SUB_STR(cmd, start, 4), acc_val)
    SET_INT_REG(82, acc_val, status)
    IF status <> 0 THEN
        resp = '1:R[82]-was-not-set'
        WRITE('Error: ', status, CR)
        RETURN(resp)
    ENDIF
    start = start + 4 + 1

    -- Extract the CNT value and write it to R[83]
    CNV_STR_INT(SUB_STR(cmd, start, 3), cnt_val)
    SET_INT_REG(83, cnt_val, status)
    IF status <> 0 THEN
        resp = '1:R[83]-was-not-set'
        WRITE('Error: ', status, CR)
        RETURN(resp)
    ENDIF
    start = start + 3 + 1

    -- Extract the motion type
    CNV_STR_INT(SUB_STR(cmd, start, 1), mtn_type)
    start = start + 1 + 1

    -- Extract the axis count
    CNV_STR_INT(SUB_STR(cmd, start, 1), nj)
    start = start + 1 + 1

    -- Read the Cartesian values from the command string
    pose = CURPOS(0, 0)
    FOR i=1 TO nj DO
        CNV_STR_REAL(SUB_STR(cmd, start, n_chars), pval)

        IF i=1 THEN
            pose.x = pval
        ENDIF

        IF i=2 THEN
            pose.y = pval
        ENDIF

        IF i=3 THEN
            pose.z = pval
        ENDIF

        IF i=4 THEN
            pose.w = pval
        ENDIF

        IF i=5 THEN
            pose.p = pval
        ENDIF

        IF i=6 THEN
            pose.r = pval
        ENDIF

        start = start + n_chars + 1
    ENDFOR

    CHECK_EPOS ((pose), $UFRAME, $UTOOL, status)
    IF status <> 0 THEN
        resp = '1:position-is-not-reachable'
        RETURN(resp)
    ENDIF

    -- Write the position to PR[81]
    SET_POS_REG(81, pose, status)
    IF status <> 0 THEN
        resp = '1:PR[81]-was-not-set'
        RETURN(resp)
    ENDIF

    IF mtn_type = 1 THEN
        -- Linear interpolation
        CALL_PROGLIN('MAPPDK_MOVEL', 1, prog_index, FALSE)
    ELSE
        -- Joint interpolation
        CALL_PROGLIN('MAPPDK_MOVE', 1, prog_index, FALSE)
    ENDIF

    resp = '0:success'
    RETURN(resp)

END MOVEP



ROUTINE MAPPDKCALL(cmd: STRING) : STRING
----------------------------------------------------
-- Calls an external TP program.
-- Command string format:
-- 'mappdkcall:PROGNAME'
----------------------------------------------------
-- Parameters:
--      cmd [in]:           command string.
----------------------------------------------------
-- Returns: response string.
----------------------------------------------------
VAR
    resp:           STRING[254]
    prg_name:       STRING[32]
    prog_index:     INTEGER
BEGIN
    -- Extract the program name from 'mappdkcall:PROG_NAME'
    prg_name = SUB_STR(cmd, 12, STR_LEN(cmd) - 11)
    CALL_PROGLIN(prg_name, 1, prog_index, FALSE)

    resp = '0:success'
    RETURN(resp)
END MAPPDKCALL


ROUTINE GET_RDO(cmd: STRING): STRING
----------------------------------------------------
-- Reads robot digital output RDO[n].
-- Command string format:
-- 'getrdo:n'
-- n: a plain number (this project relaxes it to any digit count)
----------------------------------------------------
-- Parameters:
--      cmd [in]:           command string.
----------------------------------------------------
-- Returns: response string.
----------------------------------------------------
VAR
    rdo_num:            INTEGER
BEGIN
    -- Extract the RDO number.
    -- Change in this project: was SUB_STR(cmd, 8, 1), which only takes a
    -- single character, so numbers 10 and above got truncated to their
    -- first digit and silently operated on the wrong RDO. Changed to
    -- read to the end of the string so the number can be any width.
    CNV_STR_INT(SUB_STR(cmd, 8, STR_LEN(cmd) - 7), rdo_num)

    -- Note: a number beyond how many RDOs the controller actually has
    -- throws PRIO-002 (wrong port number) here and aborts the whole
    -- server; you have to go back to the TP and RESET, then restart it.
    -- KAREL can't guard against this on its own (GET_PORT_VAL needs the
    -- io_rdo constant, which would push the directive+environment count
    -- past ktrans's limit), so the upper bound is enforced by max_rdo on
    -- the Python side instead.
    IF RDO[rdo_num] = TRUE THEN
        resp = '0:1'
        RETURN(resp)
    ENDIF

    IF RDO[rdo_num] = FALSE THEN
        resp = '0:0'
        RETURN(resp)
    ENDIF

    resp = '1:wrong-rdo-value'
    RETURN(resp)

END GET_RDO


ROUTINE SET_RDO(cmd: STRING): STRING
----------------------------------------------------
-- Sets robot digital output RDO[n].
-- Command string format:
-- 'setrdo:n:value'
-- n: a plain number (this project relaxes it to any digit count)
-- value: 'true' or 'false' (lowercase)
----------------------------------------------------
-- Parameters:
--      cmd [in]:           command string.
----------------------------------------------------
-- Returns: response string.
----------------------------------------------------
VAR
    rdo_num:            INTEGER
    rdo_val:            STRING[8]
    tail:               STRING[254]
    sep:                INTEGER
BEGIN
    -- Change in this project: was SUB_STR(cmd, 8, 1) and
    -- SUB_STR(cmd, 10, ...), which assumed the RDO number was a single
    -- digit and silently truncated anything 10 and above. Changed to
    -- locate the separator instead, so the number can be any width.
    tail = SUB_STR(cmd, 8, STR_LEN(cmd) - 7)
    sep = INDEX(tail, ':')

    IF sep < 2 THEN
        resp = '1:wrong-rdo-value'
        RETURN(resp)
    ENDIF

    -- Extract the RDO number
    CNV_STR_INT(SUB_STR(tail, 1, sep - 1), rdo_num)

    -- Extract the RDO value
    rdo_val = SUB_STR(tail, sep + 1, STR_LEN(tail) - sep)

    IF rdo_val = 'true' THEN
        RDO[rdo_num] = TRUE
        resp = '0:success'
        RETURN(resp)
    ENDIF

    IF rdo_val = 'false' THEN
        RDO[rdo_num] = FALSE
        resp = '0:success'
        RETURN(resp)
    ENDIF

    resp = '1:wrong-rdo-value'
    RETURN(resp)

END SET_RDO


ROUTINE GET_DOUT(cmd: STRING): STRING
----------------------------------------------------
-- Reads digital output DO[n].
-- Command string format:
-- 'getdout:n'
-- n: number, zero-padded to 5 digits
----------------------------------------------------
-- Parameters:
--      cmd [in]:           command string.
----------------------------------------------------
-- Returns: response string.
----------------------------------------------------
VAR
    dout_num:            INTEGER
BEGIN
    -- Extract the DO number
    CNV_STR_INT(SUB_STR(cmd, 9, 5), dout_num)

    IF DOUT[dout_num] = TRUE THEN
        DOUT[dout_num] = TRUE
        resp = '0:1'
        RETURN(resp)
    ENDIF

    IF DOUT[dout_num] = FALSE THEN
        DOUT[dout_num] = FALSE
        resp = '0:0'
        RETURN(resp)
    ENDIF

    resp = '1:wrong-dout-value'
    RETURN(resp)

END GET_DOUT

ROUTINE SET_DOUT(cmd: STRING): STRING
----------------------------------------------------
-- Sets digital output DO[n].
-- Command string format:
-- 'setdout:n:value'
-- n: number, zero-padded to 5 digits
-- value: 'true' or 'false' (lowercase)
----------------------------------------------------
-- Parameters:
--      cmd [in]:           command string.
----------------------------------------------------
-- Returns: response string.
----------------------------------------------------
VAR
    dout_num:            INTEGER
    dout_val:            STRING[8]
BEGIN
    -- Extract the DO number
    CNV_STR_INT(SUB_STR(cmd, 9, 5), dout_num)

    -- Extract the DO value
    dout_val = SUB_STR(cmd, 15, STR_LEN(cmd) - 14)

    IF dout_val = 'true' THEN
        DOUT[dout_num] = TRUE
        resp = '0:success'
        RETURN(resp)
    ENDIF

    IF dout_val = 'false' THEN
        DOUT[dout_num] = FALSE
        resp = '0:success'
        RETURN(resp)
    ENDIF

    resp = '1:wrong-dout-value'
    RETURN(resp)

END SET_DOUT

ROUTINE SET_SYS_VAR(cmd: STRING): STRING
----------------------------------------------------
-- Original author of this routine: Michael Yiu (MKS Instruments)
--                      michael.yiu@mksinst.com
--                      www.mksinst.com
--
-- Sets a system variable (boolean only).
-- Command string format:
-- 'setsysvar:n:value'
-- n: system variable name
-- value: 'T' or 'F'
----------------------------------------------------
-- Parameters:
--      cmd [in]:           command string.
----------------------------------------------------
-- Returns: response string.
----------------------------------------------------
VAR
	resp:           	STRING[254]
	sys_var:            STRING[254]
	sys_val:            STRING[8]
BEGIN
	-- Extract the system variable name
	sys_var = SUB_STR(cmd, 11, (STR_LEN(cmd) - 12))

	-- Extract the system variable's value
	sys_val = SUB_STR(cmd, 10 + STR_LEN(sys_var) + 2, 1)

	IF sys_val = 'T' THEN
		SET_VAR(entry, '*SYSTEM*', sys_var, TRUE, status)
		resp = '0:success'
		RETURN(resp)
	ENDIF

	IF sys_val = 'F' THEN
		SET_VAR(entry, '*SYSTEM*', sys_var, FALSE, status)
		resp = '0:success'
		RETURN(resp)
	ENDIF

	resp = '1:wrong-sys_var-value'
	RETURN(resp)

END SET_SYS_VAR


ROUTINE HANDLE_CMD(cmd: STRING;
                   resp: STRING) : BOOLEAN
----------------------------------------------------
-- Command dispatch.
----------------------------------------------------
-- Parameters:
--      cmd [in]:           command string.
--      resp [in/out]:      response string.
----------------------------------------------------
-- Returns: BOOLEAN, TRUE keeps the connection open, FALSE closes it.
----------------------------------------------------
BEGIN
    IF cmd = 'exit' THEN
        resp = '0:success'
        RETURN(FALSE)
    ENDIF

    -- curpos: read the Cartesian position
    IF SUB_STR(cmd, 1, 6) = 'curpos' THEN
        resp = GET_CURPOS(cmd)
        RETURN(TRUE)
    ENDIF

    -- curjpos: read the joint position
    IF SUB_STR(cmd, 1, 7) = 'curjpos' THEN
        resp = GET_CURJPOS(cmd)
        RETURN(TRUE)
    ENDIF

    -- ins_pwr: read instantaneous power
    IF SUB_STR(cmd, 1, 7) = 'ins_pwr' THEN
        resp = GET_INS_PWR(cmd)
        RETURN(TRUE)
    ENDIF

    -- movej: joint-space motion
    IF SUB_STR(cmd, 1, 5) = 'movej' THEN
        resp = MOVEJ(cmd)
        RETURN(TRUE)
    ENDIF

    -- movep: Cartesian motion
    IF SUB_STR(cmd, 1, 5) = 'movep' THEN
        resp = MOVEP(cmd)
        RETURN(TRUE)
    ENDIF

    -- mappdkcall: call an external TP program
    IF SUB_STR(cmd, 1, 10) = 'mappdkcall' THEN
        resp = MAPPDKCALL(cmd)
        RETURN(TRUE)
    ENDIF

    -- setrdo: set an RDO
    IF SUB_STR(cmd, 1, 6) = 'setrdo' THEN
        resp = SET_RDO(cmd)
        RETURN(TRUE)
    ENDIF

    -- getrdo: read an RDO
    IF SUB_STR(cmd, 1, 6) = 'getrdo' THEN
        resp = GET_RDO(cmd)
        RETURN(TRUE)
    ENDIF

     -- setdout: set a DO
    IF SUB_STR(cmd, 1, 7) = 'setdout' THEN
        resp = SET_DOUT(cmd)
        RETURN(TRUE)
    ENDIF

    -- getdout: read a DO
    IF SUB_STR(cmd, 1, 7) = 'getdout' THEN
        resp = GET_DOUT(cmd)
        RETURN(TRUE)
    ENDIF

    -- setsysvarnum: set a numeric system variable (this project's
    -- extension, implemented in mappdk_ext.kl).
    -- Must be checked first: 'setsysvarnum's first 9 characters are the
    -- same as 'setsysvar', so checking that one first would intercept it.
    IF SUB_STR(cmd, 1, 12) = 'setsysvarnum' THEN
        resp = SET_SYSVAR_NUM(cmd)
        RETURN(TRUE)
    ENDIF

    -- setsysvar: set a system variable
	IF SUB_STR(cmd, 1, 9) = 'setsysvar' THEN
        resp = SET_SYS_VAR(cmd)
        RETURN(TRUE)
	ENDIF

    ------------------------------------------------------------------
    -- Extension commands added by this project, implemented in
    -- mappdk_ext.kl. Where prefixes overlap, the longer one must be
    -- checked first, e.g. getsysvar must not be intercepted by the
    -- 9-character setsysvar check above.
    ------------------------------------------------------------------

    -- ver: report the driver version so the client can tell which
    -- commands are available
    IF cmd = 'ver' THEN
        resp = VER_INFO(cmd)
        RETURN(TRUE)
    ENDIF

    -- getreg: read numeric register R[n]
    IF SUB_STR(cmd, 1, 6) = 'getreg' THEN
        resp = GET_NUMREG(cmd)
        RETURN(TRUE)
    ENDIF

    -- setreg: write numeric register R[n]
    IF SUB_STR(cmd, 1, 6) = 'setreg' THEN
        resp = SET_NUMREG(cmd)
        RETURN(TRUE)
    ENDIF

    -- getpreg: read position register PR[n]
    IF SUB_STR(cmd, 1, 7) = 'getpreg' THEN
        resp = GET_POSREG(cmd)
        RETURN(TRUE)
    ENDIF

    -- setpreg: write position register PR[n]
    IF SUB_STR(cmd, 1, 7) = 'setpreg' THEN
        resp = SET_POSREG(cmd)
        RETURN(TRUE)
    ENDIF

    -- getdin: read digital input DI[n]
    IF SUB_STR(cmd, 1, 6) = 'getdin' THEN
        resp = GET_DIN_VAL(cmd)
        RETURN(TRUE)
    ENDIF

    -- getsysvar: read a numeric system variable
    IF SUB_STR(cmd, 1, 9) = 'getsysvar' THEN
        resp = GET_SYSVAR_NUM(cmd)
        RETURN(TRUE)
    ENDIF

    -- getalarm: read the most recent alarm
    IF SUB_STR(cmd, 1, 8) = 'getalarm' THEN
        resp = GET_ALARM(cmd)
        RETURN(TRUE)
    ENDIF

    -- getsreg: read string register SR[n]
    IF SUB_STR(cmd, 1, 7) = 'getsreg' THEN
        resp = GET_STRREG(cmd)
        RETURN(TRUE)
    ENDIF

    -- setsreg: write string register SR[n]
    IF SUB_STR(cmd, 1, 7) = 'setsreg' THEN
        resp = SET_STRREG(cmd)
        RETURN(TRUE)
    ENDIF

    -- getjpreg: read a joint-type position register
    IF SUB_STR(cmd, 1, 8) = 'getjpreg' THEN
        resp = GET_JPOSREG(cmd)
        RETURN(TRUE)
    ENDIF

    -- setjpreg: write a joint-type position register
    IF SUB_STR(cmd, 1, 8) = 'setjpreg' THEN
        resp = SET_JPOSREG(cmd)
        RETURN(TRUE)
    ENDIF

    -- chkjnt: check whether a joint angle is within the soft limits,
    -- without actually moving
    IF SUB_STR(cmd, 1, 6) = 'chkjnt' THEN
        resp = CHECK_JOINT(cmd)
        RETURN(TRUE)
    ENDIF

    -- chkpos: check whether a Cartesian position is reachable, without
    -- actually moving
    IF SUB_STR(cmd, 1, 6) = 'chkpos' THEN
        resp = CHECK_POSE(cmd)
        RETURN(TRUE)
    ENDIF

    -- none of the above matched
    WRITE('WRONG COMMAND: ', cmd, CR)
    resp = '1:wrong-command'
    RETURN(TRUE)
END HANDLE_CMD
