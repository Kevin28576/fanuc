--
-- Purpose:             MAPPDK's second connection (server tag S7 / port
--                      18736). Same command set as the main server, used
--                      to query state while the main connection is
--                      blocked on a motion command.
----------------------------------------------------
PROGRAM MAPPDK_LOGGER
%STACKSIZE = 4000
%NOLOCKGROUP
%NOPAUSE = ERROR + COMMAND + TPENABLE
%ALPHABETIZE
%COMMENT = 'MAPPDK LOGGER V0.0.1'
%ENVIRONMENT SYSDEF
%ENVIRONMENT BYNAM
%ENVIRONMENT MOTN
%ENVIRONMENT STRNG
%ENVIRONMENT REGOPE
%ENVIRONMENT ERRS
%ENVIRONMENT FLBT

VAR
    comm_file:          FILE
    status:             INTEGER
    entry:              INTEGER
    cmd:                STRING[254]
    resp:               STRING[254]
    keep_conn:          BOOLEAN

CONST
    SERVER_TAG_NUM = 7
    PORT_NUMBER = 18736


-- Includes
%INCLUDE mappdk_utils
%INCLUDE mappdk_comm
%INCLUDE mappdk_ext
%INCLUDE mappdk_cmd

BEGIN -- program start
    -- Clear the screen
    WRITE('MAPPDK LOGGER started.', CR)

    WHILE TRUE DO
        -- Open the connection
        OPEN_COMM(comm_file, SERVER_TAG_NUM, PORT_NUMBER)

        keep_conn = TRUE
        WHILE keep_conn DO
            READ comm_file(cmd)
            IF UNINIT(cmd) THEN
                keep_conn = FALSE
            ELSE
                keep_conn = HANDLE_CMD(cmd, resp)

                IF keep_conn THEN
                    WRITE comm_file (resp)
                ELSE
                    WRITE comm_file (resp)
                    READ comm_file(cmd::0)
                ENDIF
            ENDIF
        ENDWHILE

        -- Tear down the connection
        CLOSE_COMM(comm_file, SERVER_TAG_NUM)
    ENDWHILE -- main listen loop

    WRITE('MAPPDK LOGGER finished.', CR)
END MAPPDK_LOGGER
