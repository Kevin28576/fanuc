-- Purpose:             Main MAPPDK server (server tag S8 / port 18735).
----------------------------------------------------
PROGRAM MAPPDK_SERVER
%STACKSIZE = 4000
%NOLOCKGROUP
%NOPAUSE = ERROR + COMMAND + TPENABLE
%ALPHABETIZE
%COMMENT = 'MAPPDK SERVER V0.0.1'
%ENVIRONMENT SYSDEF
%ENVIRONMENT BYNAM
%ENVIRONMENT MOTN
%ENVIRONMENT STRNG
%ENVIRONMENT REGOPE
%ENVIRONMENT ERRS
%ENVIRONMENT FLBT

VAR
    comm_file:          FILE
    status:             INTEGER
    entry:              INTEGER
    cmd:                STRING[254]
    resp:               STRING[254]
    keep_conn:          BOOLEAN
    -- Not STRING[1]: CNV_INT_STR's output is space-padded, one
    -- character wider than the digit count it's converting. A
    -- single-digit frame/tool number (the ER-4iA's default UFRAMENUM
    -- 8, TOOLNUM 1 included) already overflows STRING[1], silently
    -- truncating uframe_str/tool_str and breaking the GET_VAR calls
    -- below that refresh $UFRAME/$UTOOL -- upstream fanucpy hit the
    -- same bug (torayeff/fanucpy#30), and its likely fallout
    -- (torayeff/fanucpy#28: get_curpos() not matching the TP after
    -- selecting a non-default UFRAME). STRING[254] (not just [2]) so
    -- raising UFRAMENUM/TOOLNUM past a single digit for a different
    -- robot doesn't reopen the same overflow; matches the width
    -- mappdk_ext.kl already uses for every other CNV_INT_STR output.
    uframe_str:         STRING[254]
    tool_str:           STRING[254]
    
CONST
    SERVER_TAG_NUM = 8
    PORT_NUMBER = 18735
    UFRAMENUM = 8
    TOOLNUM = 1


-- Includes
%INCLUDE mappdk_utils
%INCLUDE mappdk_comm
%INCLUDE mappdk_ext
%INCLUDE mappdk_cmd

BEGIN -- program start
    -- Clear the screen
    TP_CLS
    WRITE('MAPPDK SERVER started.', CR)

    -- Set the user frame and tool frame
    -- (undocumented upstream)
    SET_VAR(entry, '*SYSTEM*', '$MNUFRAMENUM[1]', UFRAMENUM, status)
    SET_VAR(entry, '*SYSTEM*', '$MNUTOOLNUM[1]', TOOLNUM, status)

    -- Refresh $UFRAME and $UTOOL
    CNV_INT_STR(UFRAMENUM, 1, 0, uframe_str)
    CNV_INT_STR(TOOLNUM, 1, 0, tool_str)
    GET_VAR(entry, '*SYSTEM*', '$MNUFRAME[1, ' + uframe_str + ']', $GROUP[1].$UFRAME, status)
    GET_VAR(entry, '*SYSTEM*', '$MNUTOOL[1, ' + tool_str + ']', $GROUP[1].$UTOOL, status)

    WHILE TRUE DO
        -- Open the connection
        OPEN_COMM(comm_file, SERVER_TAG_NUM, PORT_NUMBER)

        keep_conn = TRUE
        WHILE keep_conn DO
            READ comm_file(cmd)
            IF UNINIT(cmd) THEN
                keep_conn = FALSE
            ELSE
                keep_conn = HANDLE_CMD(cmd, resp)

                IF keep_conn THEN
                    WRITE comm_file (resp)
                ELSE
                    WRITE comm_file (resp)
                    READ comm_file(cmd::0)
                ENDIF
            ENDIF
        ENDWHILE

        -- Tear down the connection
        CLOSE_COMM(comm_file, SERVER_TAG_NUM)
    ENDWHILE -- main listen loop

    WRITE('MAPPDK SERVER finished.', CR)
END MAPPDK_SERVER